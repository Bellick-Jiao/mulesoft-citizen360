<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:munit="http://www.mulesoft.org/schema/mule/munit" xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
	xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xsi:schemaLocation="
		http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
		http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
		http://www.mulesoft.org/schema/mule/munit-tools  http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd">
	<munit:config name="citizen-360-process-api-test-suite.xml" />
	<munit:test name="citizen-360-process-api-test-suite-get:\citizens\(citizenId)\aggregate:citizen-360-process-api-configTest" doc:id="501da1ff-f418-48a0-a96b-e4cf73152ef1" description="Test">
		<munit:behavior >
			<munit-tools:mock-when doc:name="Mock identity HTTP" doc:id="3619b734-ca63-44f5-9149-3c0e9b1e5174" processor="http:request">
				<munit-tools:then-return >
					<munit-tools:payload value='#[{"citizenId":"RN-12345","firstName":"Jinyu","lastName":"Liang","dateOfBirth":"1983-05-12","address":{"street":"330 Cashel Street","city":"Christchurch","postcode":"8011"},"identityVerified":true,"riskBand":"LOW"}]' />
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>
		<munit:execution >
			<munit:set-event doc:name="Set Event" doc:id="bcc39e19-472e-45a4-9e20-bdf7ad370d64" >
				<munit:attributes value='#[{uriParams: {citizenId: "RN-12345"}}]' />
			</munit:set-event>
			<flow-ref doc:name="Flow-ref to get:\citizens\(citizenId)\aggregate:citizen-360-process-api-config" doc:id="b86482fc-db39-487f-9de3-636faec16cbb" name="get:\citizens\(citizenId)\aggregate:citizen-360-process-api-config"/>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-equals doc:name="Assert equals" doc:id="678a3ee8-e844-41fb-9347-c23709f841a3" actual="#[payload.citizenId]" expected="#['RN-12345']" message="citizenId should be RN-12345"/>
		</munit:validation>
	</munit:test>


</mule>
