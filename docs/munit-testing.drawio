        <mxCell id="tag4" value="THEN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9b59b6;strokeColor=#6c3483;fontColor=#ffffff;fontSize=22;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="940" y="220" width="240" height="52" as="geometry"/>
