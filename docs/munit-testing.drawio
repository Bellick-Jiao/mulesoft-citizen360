        <mxCell id="tag3" value="WHEN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e67e22;strokeColor=#a04000;fontColor=#ffffff;fontSize=22;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="650" y="220" width="240" height="52" as="geometry"/>
