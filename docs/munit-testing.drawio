        <mxCell id="b3" value="3 · Run flow&#10;&#10;Execute the aggregate&#10;Scatter-Gather flow&#10;under test" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdebd8;strokeColor=#e67e22;fontSize=22;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;fontColor=#a04000;" vertex="1" parent="1">
