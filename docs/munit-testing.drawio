          <mxGeometry x="350" y="36" width="800" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="Behavior-driven test: every outbound HTTP dependency is mocked, so the suite runs without live backends (and can run headless in CI)" style="text;html=1;fontSize=18;fontStyle=2;align=center;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="50" y="104" width="1400" height="44" as="geometry"/>
