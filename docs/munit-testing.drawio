        <mxCell id="tag5" value="RESULT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#27ae60;strokeColor=#1e8449;fontColor=#ffffff;fontSize=22;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1230" y="220" width="200" height="52" as="geometry"/>
        </mxCell>

        <mxCell id="b1" value="1 · Set Event&#10;&#10;Set inbound message:&#10;attributes = { uriParams:&#10;{ citizenId: &quot;RN-12345&quot; } }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2fb;strokeColor=#1a75bb;fontSize=22;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;fontColor=#0d4d8c;" vertex="1" parent="1">
          <mxGeometry x="55" y="300" width="270" height="300" as="geometry"/>
        </mxCell>
        <mxCell id="b2" value="2 · Mock When&#10;&#10;processor = http:request&#10;then-return fixed JSON fixtures&#10;(identity / cases / licenses)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2fb;strokeColor=#1a75bb;fontSize=22;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;fontColor=#0d4d8c;" vertex="1" parent="1">
          <mxGeometry x="345" y="300" width="270" height="300" as="geometry"/>
