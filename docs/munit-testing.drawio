        <mxCell id="note" value="Same pattern extends to asserting cases/licenses counts, aggregation shape, and fallback behavior when a mocked downstream returns an error." style="text;html=1;fontSize=18;fontStyle=2;align=center;fontColor=#555555;" vertex="1" parent="1">
