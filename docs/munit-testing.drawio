        <mxCell id="tag2" value="GIVEN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a75bb;strokeColor=#0d4d8c;fontColor=#ffffff;fontSize=22;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="220" width="240" height="52" as="geometry"/>
