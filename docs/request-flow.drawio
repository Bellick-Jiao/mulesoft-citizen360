        <mxCell id="m9" value="HTTP 200 JSON" style="edgeStyle=none;html=1;dashed=1;strokeWidth=2;strokeColor=#1a75bb;endArrow=block;fontSize=22;fontColor=#0d4d8c;labelBackgroundColor=#ffffff;" edge="1" parent="1">
