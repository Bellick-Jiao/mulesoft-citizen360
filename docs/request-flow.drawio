        <mxCell id="note" value="Latency = slowest of the 3 calls (parallel), not the sum · a failed downstream returns a fallback instead of failing the whole request" style="text;html=1;fontSize=22;fontStyle=2;align=center;fontColor=#555555;" vertex="1" parent="1">
