        <mxCell id="m8" value="aggregated 360 view" style="edgeStyle=none;html=1;dashed=1;strokeWidth=2;strokeColor=#e67e22;endArrow=block;fontSize=22;fontColor=#a04000;labelBackgroundColor=#ffffff;" edge="1" parent="1">
