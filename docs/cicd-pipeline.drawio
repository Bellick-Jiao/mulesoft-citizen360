        <mxCell id="subtitle" value="GitHub Actions builds and tests the Mule projects; a green build produces the deployable artifact for the managed runtime" style="text;html=1;fontSize=24;fontStyle=2;align=center;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="250" y="104" width="1000" height="44" as="geometry"/>
