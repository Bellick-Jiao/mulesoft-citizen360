#%RAML 1.0
---
title: Citizen 360 Experience API
version: v1
baseUri: http://localhost:8081/api
mediaType: application/json
protocols: [HTTP]

documentation:
  - title: Overview
    content: |
      Citizen 360 Experience API is the channel-facing surface of MCS.
      It aggregates identity, case, and license data for a single citizen
      in one call. Used by service-centre staff workstations and (future)
      the citizen self-service portal.

  - title: Authentication
    content: |
      All endpoints require an OAuth2 Bearer token. Staff tokens are issued
      by MCS IAM; portal tokens will be issued by RealMe in a later phase.

securitySchemes:
  oauth2:
    description: OAuth2 client-credentials / authorization-code
    type: OAuth 2.0
    describedBy:
      headers:
        Authorization:
          description: Bearer <token>
          type: string
          required: true
      responses:
        401:
          body:
            application/problem+json:
              type: Problem
              example:
                type: "about:blank"
                title: "Unauthorized"
                status: 401
                detail: "Missing or expired Bearer token"
                instance: "/citizens/RN-12345/360"
        403:
          body:
            application/problem+json:
              type: Problem

securedBy: [oauth2]

types:

  CitizenId:
    type: string
    pattern: "^RN-[0-9]{5}$"
    minLength: 8
    maxLength: 8

  Postcode:
    type: string
    pattern: "^\\d{4}$"

  Problem:
    type: object
    displayName: RFC 7807 Problem
    properties:
      type: string
      title: string
      status: number
      detail: string
      instance: string

  Address:
    type: object
    properties:
      street: string
      city: string
      postcode: Postcode

  RiskBand:
    type: string
    enum: [LOW, MEDIUM, HIGH]

  Identity:
    type: object
    properties:
      firstName: string
      lastName: string
      dateOfBirth: date-only
      address: Address
      identityVerified: boolean
      riskBand: RiskBand
      status:
        type: string
        enum: [AVAILABLE, UNAVAILABLE]
        description: Set to UNAVAILABLE when downstream identity system failed.

  CaseType:
    type: string
    enum: [BENEFIT, HOUSING, DISABILITY]

  CaseStatus:
    type: string
    enum: [NEW, IN_PROGRESS, DECIDED, CLOSED]

  Case:
    type: object
    properties:
      caseId: string
      type: CaseType
      status: CaseStatus
      openedDate: date-only
      officer: string | nil

  LicenseType:
    type: string
    enum: [DRIVING, FIREARM, ALCOHOL]

  LicenseStatus:
    type: string
    enum: [ACTIVE, EXPIRED, SUSPENDED]

  License:
    type: object
    properties:
      licenseId: string
      type: LicenseType
      status: LicenseStatus
      expiryDate: date-only

  Citizen360:
    type: object
    properties:
      citizenId: CitizenId
      identity: Identity
      cases: Case[]
      licenses: License[]
      asOf: datetime

/citizens:
  /{citizenId}:
    uriParameters:
      citizenId: CitizenId
    /360:
      get:
        description: Return the 360-degree aggregated view of one citizen.
        responses:
          200:
            body:
              application/json:
                type: Citizen360
                example:
                  citizenId: RN-12345
                  identity:
                    firstName: Jinyu
                    lastName: Liang
                    dateOfBirth: "1983-05-12"
                    address:
                      street: "330 Cashel Street"
                      city: Christchurch
                      postcode: "8011"
                    identityVerified: true
                    riskBand: LOW
                    status: AVAILABLE
                  cases:
                    - caseId: CASE-2026-001
                      type: BENEFIT
                      status: IN_PROGRESS
                      openedDate: "2026-09-15"
                      officer: "J. Smith"
                  licenses:
                    - licenseId: LIC-44556
                      type: DRIVING
                      status: ACTIVE
                      expiryDate: "2027-03-01"
                  asOf: "2026-10-22T12:00:00Z"
          404:
            body:
              application/problem+json:
                type: Problem
                example:
                  type: "about:blank"
                  title: "Citizen not found"
                  status: 404
                  detail: "No identity record for citizen RN-99999"
                  instance: "/citizens/RN-99999/360"
          503:
            body:
              application/problem+json:
                type: Problem
                example:
                  type: "about:blank"
                  title: "Downstream degraded"
                  status: 503
                  detail: "Identity and Licensing systems both unavailable"
                  instance: "/citizens/RN-12345/360"
